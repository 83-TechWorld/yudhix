# Copy to .env (git-ignored) and fill in. Loaded by app/core/config.py on start.
# Real environment variables take priority over this file.

# Pulls comments (and views, publish date) for newly analyzed videos.
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# Comments kept per analysis, and which ones:
#   spread = 40% newest, 40% oldest, 20% random from the middle (other stored comments are archived)
#   top    = the most relevant ones, as YouTube ranks them
MAX_COMMENTS_PER_VIDEO=100
COMMENT_SAMPLING=spread
